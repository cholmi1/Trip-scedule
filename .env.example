# ── TripCost 환경 변수 ─────────────────────────────────────
# 이 파일을 .env.local 로 복사하고 값을 채우세요.
# cp .env.example .env.local
#
# .env.local 은 .gitignore 에 포함되어 커밋되지 않습니다.

# ── 항공편 (Skyscanner / Amadeus) ──────────────────────────
# Amadeus: https://developers.amadeus.com 에서 발급
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Skyscanner (RapidAPI) — 하루 상위 1,500건 무료 티어
SKYSKANNER_API_KEY=
SKYSKANNER_API_HOST=skyscanner80.p.rapidapi.com

# ── 장소 / 맛집 (Google Places) ────────────────────────────
# https://console.cloud.google.com 에서 Maps JavaScript API + Places API 활성화
GOOGLE_PLACES_KEY=
GOOGLE_MAPS_KEY=

# ── 숙박 (선택) ────────────────────────────────────────────
BOOKING_DEMAND_API_KEY=

# ── 사용자 저장 (선택, Supabase) ───────────────────────────
# https://supabase.com 에서 프로젝트 생성 후 URL / anon key 복사
SUPABASE_URL=
SUPABASE_ANON_KEY=